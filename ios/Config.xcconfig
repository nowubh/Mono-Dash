// Configuration file for dynamic identifiers (unsigned / re-signed builds)
// When re-signing with a different team, update BUNDLE_ID_PREFIX and TEAM_ID
// to match your Apple Developer Team settings.

// Your bundle ID prefix (usually reverse-domain, e.g. com.yourname)
BUNDLE_ID_PREFIX = cc.boring-lab

// Main app bundle ID
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).monodash

// Widget extension bundle ID (must be a sub-path of main app)
WIDGET_BUNDLE_ID = $(PRODUCT_BUNDLE_IDENTIFIER).ServerStatusWidgetExtension
WIDGET_INTENTS_BUNDLE_ID = $(PRODUCT_BUNDLE_IDENTIFIER).ServerStatusWidgetIntentsExtension

// App Group identifier (for sharing data between app and widgets)
// format: group.<bundle-id-prefix>.<app-name>
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).monodash

// Your Development Team ID (10-character alphanumeric, found at developer.apple.com)
// Leave empty for unsigned builds
DEVELOPMENT_TEAM = 53R8Z6YBWK

// Code signing style
CODE_SIGN_STYLE = Automatic

// iCloud KV Store identifier (requires paid Apple Developer account)
// Format: $(TeamIdentifierPrefix)bundle.id
// Leave UBIQUITY_STORE_ENABLED = NO for free accounts / unsigned builds
UBIQUITY_STORE_ENABLED = NO
UBIQUITY_KVSTORE_IDENTIFIER = $(TeamIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)
