// Shared identifiers for the app and its extensions.
//
// This file is included by Flutter's Debug/Release xcconfig (for the Runner
// target) and set as the base configuration of both extension targets, so the
// values below are visible everywhere Info.plist and *.entitlements are
// processed.
//
// To build under your own Apple Developer account, change BUNDLE_ID_PREFIX and
// DEVELOPMENT_TEAM. Everything else is derived, so the app, the widget and the
// intents extension stay consistent and no identifier has to be hardcoded in
// Swift.

// Reverse-domain prefix that you control, e.g. com.yourname
BUNDLE_ID_PREFIX = cc.boring-lab

// Main app bundle ID. Extensions derive their own IDs from this.
APP_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).monodash

// App Group shared by the app and the extensions. Must be `group.` + a domain
// registered to your team; WidgetSharedConfig also probes this at runtime so a
// re-signed build recovers even if this value is stale.
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).monodash

// 10-character Team ID from developer.apple.com. Leave empty to build unsigned
// (`flutter build ios --no-codesign`).
DEVELOPMENT_TEAM = 53R8Z6YBWK
